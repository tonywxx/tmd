{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main, focus and export windows",
  "windows": [
    "main",
    "export",
    "focus",
    "focus-1",
    "focus-2",
    "focus-3",
    "focus-4",
    "focus-5",
    "focus-6",
    "focus-7",
    "focus-8",
    "focus-9",
    "focus-10",
    "main-2",
    "main-3",
    "main-4",
    "main-5",
    "main-6",
    "main-7",
    "main-8",
    "main-9"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-set-fullscreen",
    "core:webview:allow-print",
    "opener:default",
    "dialog:default",
    "updater:default",
    "global-shortcut:default",
    "deep-link:default",
    "allow-read-file",
    "allow-write-file",
    "allow-read-directory",
    "allow-file-stat",
    "allow-file-exists",
    "allow-file-basename",
    "allow-file-dirname",
    "allow-file-resolve-path",
    "allow-file-rename",
    "allow-file-mkdir",
    "allow-file-create",
    "allow-file-trash",
    "allow-file-show-in-folder",
    "allow-search-in-folder",
    "allow-export-html",
    "allow-watch-file-cmd",
    "allow-unwatch-file-cmd",
    "allow-watch-directory-cmd",
    "allow-unwatch-directory-cmd",
    "allow-git-get-baseline",
    "allow-settings-get",
    "allow-settings-set",
    "allow-recent-get-files",
    "allow-recent-add-file",
    "allow-session-get",
    "allow-session-set",
    "allow-app-version",
    "allow-app-home-dir",
    "allow-app-open-external",
    "allow-is-image-allowed",
    "allow-image-data-uri",
    "allow-focus-open-window",
    "allow-focus-bring-to-front",
    "allow-update-global-hotkey-cmd",
    "allow-print-window",
    "allow-log-frontend-error"
  ]
}
